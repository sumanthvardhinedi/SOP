# Public frontend configuration only. VITE_ variables are included in browser assets.
# Leave empty to use the same-origin /api proxy (recommended for local development).
VITE_API_BASE_URL=
# For a separately hosted API with CORS enabled, for example:
# VITE_API_BASE_URL=http://127.0.0.1:8000

# Vite development proxy target; this is not bundled into the browser.
API_PROXY_TARGET=http://127.0.0.1:8000
